// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─────────────────────────────────────────────────────────────
// Vigor Manager: control de lotes y fechas de caducidad
// ─────────────────────────────────────────────────────────────
model Lote {
  id          Int      @id @default(autoincrement())
  shop        String
  variantId   String // gid://shopify/ProductVariant/...
  productName String
  sku         String
  codigoLote  String
  caducidad   DateTime
  unidades    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, variantId, codigoLote])
  @@index([shop, caducidad])
}

model Ajustes {
  shop          String @id
  umbralStock   Int    @default(10) // avisar si quedan menos unidades
  diasCaducidad Int    @default(60) // avisar si caduca antes de N días
}
