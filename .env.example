# Variables del servidor en PRODUCCIÓN (configúralas en tu hosting, nunca en GitHub).
# En desarrollo no hacen falta: `shopify app dev` las inyecta automáticamente.
SHOPIFY_API_KEY=            # Client ID de la app
SHOPIFY_API_SECRET=         # Client secret (¡secreto!)
SHOPIFY_APP_URL=https://vigor-manager.example.com
SCOPES=write_products,write_inventory,read_locations,write_publications,write_discounts
NODE_ENV=production
