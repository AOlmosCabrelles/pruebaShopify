{%- comment -%} Vigor Sport Nutrition · franja de beneficios con iconos {%- endcomment -%}
<div class="vigor-section vigor-beneficios" style="--vigor-pad: {{ section.settings.padding }}px;">
  <div class="vigor-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="vigor-section__heading h3">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="vigor-section__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="vigor-beneficios__grid">
      {%- for block in section.blocks -%}
        <div class="vigor-beneficio" {{ block.shopify_attributes }}>
          <span class="vigor-beneficio__icono">
            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 20 20">
              {%- render 'icon', icon: block.settings.icon -%}
            </svg>
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vigor · Beneficios",
  "tag": "section",
  "class": "vigor-beneficios-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Por qué Vigor?" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "range", "id": "padding", "label": "Espaciado vertical", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "default": "check_box",
          "options": [
            { "value": "check_box", "label": "Check" },
            { "value": "truck", "label": "Envío" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "return", "label": "Devoluciones" },
            { "value": "lightning_bolt", "label": "Energía" },
            { "value": "fire", "label": "Fuego" },
            { "value": "stopwatch", "label": "Cronómetro" },
            { "value": "leaf", "label": "Natural" },
            { "value": "heart", "label": "Corazón" },
            { "value": "star", "label": "Estrella" },
            { "value": "clipboard", "label": "Ficha" },
            { "value": "chat_bubble", "label": "Atención" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Describe el beneficio en una frase." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Vigor · Beneficios",
      "blocks": [
        { "type": "beneficio", "settings": { "icon": "clipboard", "title": "Fórmulas transparentes", "text": "Sabes exactamente lo que tomas y en qué cantidad." } },
        { "type": "beneficio", "settings": { "icon": "truck", "title": "Envío en 48-72 h", "text": "Gratis en pedidos de más de 50 €." } },
        { "type": "beneficio", "settings": { "icon": "lock", "title": "Pago seguro", "text": "Tarjeta, Bizum, Apple Pay y Google Pay." } }
      ]
    }
  ]
}
{% endschema %}
