{%- comment -%}
  Vigor Sport Nutrition · página de todas las categorías (/collections).
  Primero las categorías Vigor (con su color e ilustración), luego el resto de colecciones.
{%- endcomment -%}
{%- liquid
  assign principales = 'proteinas,rendimiento,recuperacion,salud,snacks,accesorios' | split: ','
  assign total_productos = collections.all.products_count
-%}

<div class="vigor-cats-hero">
  <div class="vigor-cats-hero__palabra" aria-hidden="true">CATEGORÍAS</div>
  <div class="vigor-section__inner">
    <nav class="vigor-cabecera__migas" aria-label="Ruta de navegación">
      <a href="{{ routes.root_url }}">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Categorías</span>
    </nav>
    <h1 class="vigor-cats-hero__titulo">{{ section.settings.heading }}</h1>
    <p class="vigor-cats-hero__texto">{{ section.settings.text }}</p>
  </div>
</div>

<div class="vigor-section" style="--vigor-pad: 40px;">
  <div class="vigor-section__inner">
    <div class="vigor-cats-grid">
      {%- for handle in principales -%}
        {%- assign c = collections[handle] -%}
        {%- if c.products_count > 0 -%}
          {%- capture color -%}{%- render 'vigor-coleccion-info', handle: handle, dato: 'color' -%}{%- endcapture -%}
          {%- capture texto -%}{%- render 'vigor-coleccion-info', handle: handle, dato: 'texto' -%}{%- endcapture -%}
          {%- assign color = color | strip -%}{%- assign texto = texto | strip -%}
          {%- if c.description != blank -%}{%- assign texto = c.description | strip_html | truncatewords: 22 -%}{%- endif -%}
          {%- if c.image != blank -%}
            {%- assign src = c.image | image_url: width: 1000 -%}
          {%- else -%}
            {%- assign src = 'vigor-cat-' | append: handle | append: '.jpg' | asset_url -%}
          {%- endif -%}
          <a href="{{ c.url }}" class="vigor-cat-card{% if forloop.first %} vigor-cat-card--destacada{% endif %}" style="--vigor-cat: {{ color }};">
            <img src="{{ src }}" alt="" loading="{% if forloop.index < 3 %}eager{% else %}lazy{% endif %}" width="1000" height="1250">
            <span class="vigor-cat-card__contenido">
              <span class="vigor-cat-card__contador">{{ c.products_count }} {% if c.products_count == 1 %}producto{% else %}productos{% endif %}</span>
              <span class="vigor-cat-card__titulo">{{ c.title }}</span>
              <span class="vigor-cat-card__texto">{{ texto }}</span>
              <span class="vigor-cat-card__cta">Ver {{ c.title | downcase }} <span aria-hidden="true">→</span></span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}

      <a href="{{ routes.all_products_collection_url }}" class="vigor-cat-card vigor-cat-card--todos">
        <span class="vigor-cat-card__contenido">
          <span class="vigor-cat-card__contador">{{ total_productos }} productos</span>
          <span class="vigor-cat-card__titulo">Todo el catálogo</span>
          <span class="vigor-cat-card__texto">¿No sabes por dónde empezar? Mira todos nuestros productos juntos.</span>
          <span class="vigor-cat-card__cta">Ver todo <span aria-hidden="true">→</span></span>
        </span>
      </a>
    </div>

    {%- assign hay_otras = false -%}
    {%- for c in collections -%}
      {%- unless principales contains c.handle or c.handle == 'all' or c.handle == 'frontpage' or c.products_count == 0 -%}
        {%- assign hay_otras = true -%}
        {%- break -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if hay_otras -%}
      <h2 class="vigor-cats-otras__titulo h4">{{ section.settings.heading_otras }}</h2>
      <div class="vigor-chips vigor-chips--sueltas">
        {%- for c in collections -%}
          {%- unless principales contains c.handle or c.handle == 'all' or c.handle == 'frontpage' or c.products_count == 0 -%}
            <a class="vigor-chip" href="{{ c.url }}">{{ c.title }} <span class="vigor-chip__n">{{ c.products_count }}</span></a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vigor · Todas categorías",
  "tag": "section",
  "class": "vigor-lista-colecciones-section",
  "enabled_on": { "templates": ["list-collections"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige tu objetivo" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Te lo ponemos fácil: cada categoría reúne los productos para un objetivo concreto." },
    { "type": "text", "id": "heading_otras", "label": "Título de otras colecciones", "default": "Más colecciones" }
  ],
  "presets": [{ "name": "Vigor · Todas categorías" }]
}
{% endschema %}
