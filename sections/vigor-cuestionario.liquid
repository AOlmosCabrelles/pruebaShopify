{%- comment -%}
  Vigor Sport Nutrition · cuestionario "Encuentra tu suplemento".
  Dos preguntas: el objetivo y, según el objetivo, la única que cambia la recomendación
  (músculo → lácteos · rendimiento → cafeína · recuperación y salud → dieta vegana).
  Recomienda hasta 3 productos.

  Las recomendaciones se definen abajo en RECOMENDACIONES con los identificadores (handles)
  de los productos. Si un producto no existe o está agotado, se omite y se usa el siguiente.
{%- endcomment -%}
{%- liquid
  assign handles = 'whey-protein-isolate,whey-protein-concentrada,caseina-micelar,proteina-vegana,creatina-monohidrato,crema-de-cacahuete,pre-entreno-explosive,beta-alanina,citrulina-malato,bebida-isotonica,bcaa-2-1-1,l-glutamina,colageno-magnesio,multivitaminico-sport,omega-3,vitamina-d3-k2,magnesio-bisglicinato,barritas-proteicas-caja-12,galletas-proteicas-caja-12' | split: ','
-%}

<div class="vigor-section vigor-quiz" id="encuentra-tu-suplemento" style="--vigor-pad: {{ section.settings.padding }}px;">
  <div class="vigor-section__inner">
    <h2 class="vigor-section__heading">{{ section.settings.heading }}</h2>
    <p class="vigor-section__subheading">{{ section.settings.subheading }}</p>

    <div class="vigor-quiz__caja" data-vigor-quiz>
      <ol class="vigor-quiz__progreso" aria-hidden="true">
        <li class="is-activo"></li><li></li>
      </ol>

      <fieldset class="vigor-quiz__paso is-activo" data-paso="1">
        <legend>1 · ¿Cuál es tu objetivo principal?</legend>
        <div class="vigor-quiz__opciones">
          <button type="button" data-valor="musculo">💪 Ganar músculo</button>
          <button type="button" data-valor="rendimiento">⚡ Rendir más</button>
          <button type="button" data-valor="recuperacion">⏱️ Recuperarme mejor</button>
          <button type="button" data-valor="salud">❤️ Cuidar mi salud</button>
        </div>
      </fieldset>

      {%- comment -%} Segunda pregunta: solo se muestra la que corresponde al objetivo {%- endcomment -%}
      <fieldset class="vigor-quiz__paso" data-paso="lacteos">
        <legend>2 · ¿Tomas lácteos?</legend>
        <div class="vigor-quiz__opciones">
          <button type="button" data-valor="todo">Sí, sin problema</button>
          <button type="button" data-valor="sinlacteos">No (intolerancia o alergia)</button>
          <button type="button" data-valor="vegano">No, soy vegano/a</button>
        </div>
      </fieldset>

      <fieldset class="vigor-quiz__paso" data-paso="cafeina">
        <legend>2 · ¿Y la cafeína?</legend>
        <div class="vigor-quiz__opciones">
          <button type="button" data-valor="si">Me sienta bien</button>
          <button type="button" data-valor="no">Prefiero evitarla</button>
        </div>
      </fieldset>

      <fieldset class="vigor-quiz__paso" data-paso="vegano">
        <legend>2 · ¿Sigues una dieta vegana?</legend>
        <div class="vigor-quiz__opciones">
          <button type="button" data-valor="todo">No</button>
          <button type="button" data-valor="vegano">Sí, soy vegano/a</button>
        </div>
      </fieldset>

      <div class="vigor-quiz__resultado" data-resultado hidden>
        <h3>Tu combinación Vigor</h3>
        <p class="vigor-quiz__explicacion" data-explicacion></p>
        <div class="vigor-quiz__productos" data-productos></div>
        <p class="vigor-quiz__aviso">{{ section.settings.aviso }}</p>
        <button type="button" class="vigor-quiz__reiniciar" data-reiniciar>↺ Volver a empezar</button>
      </div>
    </div>
  </div>

  {%- comment -%} Datos de los productos para el cuestionario {%- endcomment -%}
  <script type="application/json" data-vigor-quiz-productos>
    {
      {%- assign primero = true -%}
      {%- for h in handles -%}
        {%- assign p = all_products[h] -%}
        {%- if p != blank and p.available -%}
          {%- unless primero -%},{%- endunless -%}
          {%- assign primero = false -%}
          {{ h | json }}: {
            "titulo": {{ p.title | json }},
            "url": {{ p.url | json }},
            "precio": {{ p.price | money | json }},
            "imagen": {{ p.featured_image | image_url: width: 400 | json }},
            "variante": {{ p.selected_or_first_available_variant.id | json }}
          }
        {%- endif -%}
      {%- endfor -%}
    }
  </script>
</div>

<script>
  (() => {
    const raiz = document.querySelector('#shopify-section-{{ section.id }} [data-vigor-quiz]');
    if (!raiz) return;
    const productos = JSON.parse(document.querySelector('#shopify-section-{{ section.id }} [data-vigor-quiz-productos]').textContent || '{}');

    // Objetivo → lácteos → cafeína → lista de productos por prioridad
    const RECOMENDACIONES = {
      musculo: {
        // Tercer puesto: tentempié proteico (barritas; si están agotadas, galletas)
        lacteos: ['whey-protein-isolate', 'creatina-monohidrato', 'barritas-proteicas-caja-12', 'galletas-proteicas-caja-12', 'caseina-micelar', 'whey-protein-concentrada'],
        sinLacteos: ['proteina-vegana', 'creatina-monohidrato', 'crema-de-cacahuete'],
        texto: 'Para ganar músculo lo básico es llegar a tu proteína diaria y entrenar fuerza. La creatina te ayuda a rendir más en cada serie, y un tentempié proteico te facilita llegar a tu proteína entre horas.',
      },
      rendimiento: {
        cafeina: ['pre-entreno-explosive', 'creatina-monohidrato', 'beta-alanina'],
        sinCafeina: ['citrulina-malato', 'beta-alanina', 'creatina-monohidrato', 'bebida-isotonica'],
        texto: 'Para rendir más en sesiones intensas, un pre-entreno o sus ingredientes por separado. Si haces fondo, la isotónica te ayuda a mantener el ritmo.',
      },
      recuperacion: {
        todos: ['bcaa-2-1-1', 'l-glutamina', 'colageno-magnesio', 'magnesio-bisglicinato'],
        texto: 'La recuperación empieza por dormir bien y comer suficiente. Estos productos te ayudan a completar tu rutina después de entrenar.',
      },
      salud: {
        todos: ['multivitaminico-sport', 'omega-3', 'vitamina-d3-k2', 'magnesio-bisglicinato'],
        texto: 'Cubre la base: vitaminas, minerales y omega-3, sobre todo si entrenas mucho o tu alimentación no siempre es perfecta.',
      },
    };

    // Segunda pregunta según el objetivo: solo la que cambia la recomendación
    const SEGUNDA = { musculo: 'lacteos', rendimiento: 'cafeina', recuperacion: 'vegano', salud: 'vegano' };

    // Filtros generales. Mantener al día si cambia el catálogo:
    //  - con leche: fuera si "sin lácteos" o "vegano"
    //  - de origen animal (o que pueden serlo, como la vitamina D3): fuera si "vegano"
    //  - con cafeína: fuera si "prefiero evitarla"
    const CON_LECHE = ['whey-protein-isolate', 'whey-protein-concentrada', 'caseina-micelar', 'barritas-proteicas-caja-12', 'galletas-proteicas-caja-12'];
    const ANIMAL = ['omega-3', 'colageno-magnesio', 'vitamina-d3-k2'];
    const CON_CAFEINA = ['pre-entreno-explosive', 'cafeina-200'];

    const respuestas = {};
    const pasos = [...raiz.querySelectorAll('[data-paso]')];
    const puntos = [...raiz.querySelectorAll('.vigor-quiz__progreso li')];
    const resultado = raiz.querySelector('[data-resultado]');

    // paso: '1', el nombre de la segunda pregunta, o null para ver el resultado
    const mostrarPaso = (paso) => {
      pasos.forEach((p) => p.classList.toggle('is-activo', p.dataset.paso === paso));
      const hechos = paso === '1' ? 1 : 2;
      puntos.forEach((p, i) => p.classList.toggle('is-activo', i < hechos));
      resultado.hidden = paso !== null;
    };

    const elegir = () => {
      const r = RECOMENDACIONES[respuestas.objetivo];
      const dieta = respuestas.dieta || 'todo';
      const sinLeche = dieta === 'sinlacteos' || dieta === 'vegano';
      let lista;
      if (r.todos) lista = r.todos;
      else if (r.lacteos) lista = sinLeche ? r.sinLacteos : r.lacteos;
      else lista = respuestas.cafeina === 'no' ? r.sinCafeina : r.cafeina;
      const quitados = [];
      lista = lista.filter((h) => {
        const fuera = (sinLeche && CON_LECHE.includes(h)) ||
          (dieta === 'vegano' && ANIMAL.includes(h)) ||
          (respuestas.cafeina === 'no' && CON_CAFEINA.includes(h));
        if (fuera && dieta === 'vegano' && ANIMAL.includes(h) && productos[h]) quitados.push(productos[h].titulo);
        return !fuera;
      });
      let texto = r.texto;
      if (quitados.length) texto += ` Como eres vegano/a, hemos quitado lo que es de origen animal (${quitados.join(', ')}).`;
      return { handles: lista.filter((h) => productos[h]).slice(0, 3), texto };
    };

    const pintarResultado = () => {
      const { handles, texto } = elegir();
      raiz.querySelector('[data-explicacion]').textContent = texto;
      const cont = raiz.querySelector('[data-productos]');
      cont.innerHTML = '';
      for (const h of handles) {
        const p = productos[h];
        const tarjeta = document.createElement('article');
        tarjeta.className = 'vigor-quiz__producto';
        tarjeta.innerHTML = `
          <a href="${p.url}" class="vigor-quiz__imagen">${p.imagen ? `<img src="${p.imagen}" alt="" loading="lazy" width="400" height="400">` : ''}</a>
          <a href="${p.url}" class="vigor-quiz__titulo"></a>
          <span class="vigor-quiz__precio"></span>
          <form method="post" action="{{ routes.cart_add_url }}">
            <input type="hidden" name="id" value="${p.variante}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="vigor-boton vigor-boton--primario">Añadir al carrito</button>
          </form>`;
        tarjeta.querySelector('.vigor-quiz__titulo').textContent = p.titulo;
        tarjeta.querySelector('.vigor-quiz__precio').textContent = p.precio;
        cont.appendChild(tarjeta);
      }
      if (!handles.length) cont.innerHTML = '<p>Ahora mismo no hay productos disponibles para esta combinación. Escríbenos y te ayudamos.</p>';
    };

    raiz.addEventListener('click', (e) => {
      const opcion = e.target.closest('[data-paso] button');
      if (opcion) {
        const paso = opcion.closest('[data-paso]').dataset.paso;
        const valor = opcion.dataset.valor;
        if (paso === '1') {
          Object.keys(respuestas).forEach((k) => delete respuestas[k]);
          respuestas.objetivo = valor;
          mostrarPaso(SEGUNDA[valor]);
          return;
        }
        if (paso === 'cafeina') respuestas.cafeina = valor;
        else respuestas.dieta = valor;
        pintarResultado();
        mostrarPaso(null);
      }
      if (e.target.closest('[data-reiniciar]')) {
        Object.keys(respuestas).forEach((k) => delete respuestas[k]);
        mostrarPaso('1');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Vigor · Cuestionario",
  "tag": "section",
  "class": "vigor-cuestionario-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Encuentra tu suplemento" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Dos preguntas y te decimos qué encaja contigo." },
    { "type": "text", "id": "aviso", "label": "Aviso", "default": "Recomendación orientativa. Si tienes alguna patología, estás embarazada o tomas medicación, consulta antes con un profesional sanitario." },
    { "type": "range", "id": "padding", "label": "Espaciado vertical", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Vigor · Cuestionario" }]
}
{% endschema %}
