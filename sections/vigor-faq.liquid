{%- comment -%} Vigor Sport Nutrition · preguntas frecuentes (con datos estructurados para Google) {%- endcomment -%}
<div class="vigor-section vigor-faq" style="--vigor-pad: {{ section.settings.padding }}px;">
  <div class="vigor-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="vigor-section__heading h3">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="vigor-faq__lista">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="vigor-faq__respuesta">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Vigor · FAQ",
  "tag": "section",
  "class": "vigor-faq-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "checkbox", "id": "open_first", "label": "Abrir la primera pregunta", "default": false },
    { "type": "range", "id": "padding", "label": "Espaciado vertical", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Pregunta?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vigor · FAQ",
      "blocks": [
        { "type": "pregunta", "settings": { "question": "¿Cuánto tarda el envío?", "answer": "<p>Entre 48 y 72 horas laborables en España peninsular. Gratis en pedidos de más de 50 €.</p>" } },
        { "type": "pregunta", "settings": { "question": "¿Puedo devolver un producto?", "answer": "<p>Sí, dispones de 14 días si el envase está cerrado y precintado.</p>" } }
      ]
    }
  ]
}
{% endschema %}
