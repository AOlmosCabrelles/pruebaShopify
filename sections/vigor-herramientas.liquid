{%- comment -%}
  Vigor Sport Nutrition · cabecera de la página "Herramientas".
  Título grande + accesos directos (bloques) a cada herramienta de la página.
  Cada acceso apunta a un ancla (#creatina, #calorias…) que coincide con el campo
  "Ancla" de la sección correspondiente.
{%- endcomment -%}
{%- liquid
  assign titulo = section.settings.heading
  if titulo == blank and page
    assign titulo = page.title
  endif
-%}
<div class="vigor-cats-hero vigor-tools-hero">
  <div class="vigor-cats-hero__palabra" aria-hidden="true">{{ section.settings.palabra }}</div>
  <div class="vigor-section__inner">
    <nav class="vigor-cabecera__migas" aria-label="Ruta de navegación">
      <a href="{{ routes.root_url }}">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">{{ titulo }}</span>
    </nav>
    <h1 class="vigor-cats-hero__titulo">{{ titulo }}</h1>
    {%- if section.settings.text != blank -%}<p class="vigor-cats-hero__texto">{{ section.settings.text }}</p>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="vigor-tools-atajos">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="vigor-tools-atajo" href="#{{ block.settings.ancla | handleize }}">
              <span class="vigor-tools-atajo__icono" aria-hidden="true">{{ block.settings.icono }}</span>
              <span class="vigor-tools-atajo__titulo">{{ block.settings.title }}</span>
              <span class="vigor-tools-atajo__texto">{{ block.settings.text }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vigor · Herramientas",
  "tag": "section",
  "class": "vigor-herramientas-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "info": "Vacío = el título de la página." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Calculadoras y guías para sacar el máximo partido a tu entrenamiento y a tus suplementos." },
    { "type": "text", "id": "palabra", "label": "Palabra de fondo", "default": "ENTRENA" }
  ],
  "blocks": [
    {
      "type": "atajo",
      "name": "Acceso directo",
      "settings": [
        { "type": "text", "id": "icono", "label": "Icono (emoji)", "default": "⚡" },
        { "type": "text", "id": "title", "label": "Título", "default": "Herramienta" },
        { "type": "text", "id": "text", "label": "Texto corto" },
        { "type": "text", "id": "ancla", "label": "Ancla", "info": "La misma que pusiste en la sección de destino (por ejemplo: creatina). La del cuestionario es encuentra-tu-suplemento y la de las preguntas frecuentes, preguntas-frecuentes." }
      ]
    }
  ],
  "presets": [{ "name": "Vigor · Herramientas" }]
}
{% endschema %}
