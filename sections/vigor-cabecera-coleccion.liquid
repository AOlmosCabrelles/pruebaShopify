{%- comment -%}
  Vigor Sport Nutrition · cabecera visual de colección.
  Cada categoría tiene su color, su ilustración y un texto por defecto.
  - Color: según el identificador de la colección (proteinas, rendimiento...).
  - Imagen: la de la colección si la tiene; si no, la ilustración de ejemplo del tema.
  - Texto: la descripción de la colección; si está vacía, un texto por defecto.
{%- endcomment -%}
{%- capture color -%}{%- render 'vigor-coleccion-info', handle: collection.handle, dato: 'color' -%}{%- endcapture -%}
{%- capture palabra -%}{%- render 'vigor-coleccion-info', handle: collection.handle, dato: 'palabra' -%}{%- endcapture -%}
{%- capture texto -%}{%- render 'vigor-coleccion-info', handle: collection.handle, dato: 'texto' -%}{%- endcapture -%}
{%- liquid
  assign color = color | strip
  assign palabra = palabra | strip
  assign texto = texto | strip
  assign c = collection
  assign h = c.handle


  assign ejemplos = 'proteinas,rendimiento,recuperacion,salud,snacks,accesorios' | split: ','
  if c.image != blank
    assign src = c.image | image_url: width: 2000
  elsif ejemplos contains h
    assign src = 'vigor-cabecera-' | append: h | append: '.jpg' | asset_url
  elsif c.products.first.featured_image != blank
    assign src = c.products.first.featured_image | image_url: width: 1600
  else
    assign src = 'vigor-nosotros.jpg' | asset_url
  endif

  if c.description != blank
    assign texto = c.description | strip_html | truncatewords: 40
  endif
-%}

<div class="vigor-cabecera vigor-cabecera--{{ section.settings.estilo_imagen }}" style="--vigor-cat: {{ color }};">
  {%- if section.settings.estilo_imagen == 'fondo' -%}
    <div class="vigor-cabecera__fondo" aria-hidden="true">
      <img src="{{ src }}" alt="" width="2000" height="700" fetchpriority="high">
    </div>
  {%- endif -%}
  {%- if section.settings.estilo_imagen != 'fondo' -%}
    <div class="vigor-cabecera__palabra" aria-hidden="true">{{ palabra }}</div>
  {%- endif -%}
  <div class="vigor-cabecera__inner">
    <div class="vigor-cabecera__texto">
      <nav class="vigor-cabecera__migas" aria-label="Ruta de navegación">
        <a href="{{ routes.root_url }}">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">Categorías</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ c.title | default: 'Todos los productos' }}</span>
      </nav>
      <h1 class="vigor-cabecera__titulo">{{ c.title | default: 'Todos los productos' }}</h1>
      <p class="vigor-cabecera__descripcion">{{ texto }}</p>
      <span class="vigor-cabecera__contador">
        {{ c.products_count }}
        {% if c.products_count == 1 %}producto{% else %}productos{% endif %}
      </span>
    </div>
  </div>
</div>

{%- if section.settings.show_chips -%}
  {%- assign actual = h -%}
  <nav class="vigor-chips" aria-label="Categorías">
    <a class="vigor-chip{% if actual == 'all' or actual == blank %} vigor-chip--activa{% endif %}" href="{{ routes.all_products_collection_url }}">Todo</a>
    {%- for handle in ejemplos -%}
      {%- assign col = collections[handle] -%}
      {%- if col.products_count > 0 -%}
        <a class="vigor-chip{% if actual == handle %} vigor-chip--activa{% endif %}" href="{{ col.url }}">{{ col.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Vigor · Cabecera",
  "tag": "section",
  "class": "vigor-cabecera-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "select", "id": "estilo_imagen", "label": "Imagen de la categoría", "default": "fondo",
      "options": [
        { "value": "fondo", "label": "De fondo (a todo lo ancho)" },
        { "value": "sin-imagen", "label": "Sin imagen (solo color)" }
      ]
    },
    { "type": "checkbox", "id": "show_chips", "label": "Mostrar accesos rápidos a otras categorías", "default": true },
    { "type": "paragraph", "content": "El color, la ilustración y el texto por defecto dependen de la colección. Para cambiar el texto, escribe una descripción en la colección (Productos → Colecciones). Para cambiar la imagen, sube una imagen de colección." }
  ],
  "presets": [{ "name": "Vigor · Cabecera" }]
}
{% endschema %}
