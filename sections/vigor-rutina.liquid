{%- comment -%} Vigor Sport Nutrition · "Tu día con Vigor": cuándo tomar cada suplemento {%- endcomment -%}
<div class="vigor-section vigor-rutina" style="--vigor-pad: {{ section.settings.padding }}px;">
  <div class="vigor-section__inner">
    {%- if section.settings.heading != blank -%}<h2 class="vigor-section__heading h3">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="vigor-section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    <ol class="vigor-rutina__linea">
      {%- for block in section.blocks -%}
        <li class="vigor-rutina__paso" {{ block.shopify_attributes }}>
          <span class="vigor-rutina__momento">{{ block.settings.momento }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.product != blank -%}
            {%- assign p = block.settings.product -%}
            <a class="vigor-rutina__producto" href="{{ p.url }}">
              {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: p.title, width: 56, height: 56 }}{%- endif -%}
              <span><strong>{{ p.title }}</strong>{{ p.price | money }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.aviso != blank -%}<p class="vigor-rutina__aviso">{{ section.settings.aviso }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vigor · Tu día",
  "tag": "section",
  "class": "vigor-rutina-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu día con Vigor" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Cuándo tomar cada suplemento para sacarle el máximo partido." },
    { "type": "text", "id": "aviso", "label": "Aviso", "default": "Orientación general. Adapta las tomas a tu entrenamiento y consulta con un profesional si tienes dudas." },
    { "type": "range", "id": "padding", "label": "Espaciado vertical", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "momento",
      "name": "Momento del día",
      "settings": [
        { "type": "text", "id": "momento", "label": "Momento", "default": "Mañana" },
        { "type": "text", "id": "title", "label": "Título", "default": "Empieza bien" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "product", "id": "product", "label": "Producto recomendado" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Vigor · Tu día" }]
}
{% endschema %}
