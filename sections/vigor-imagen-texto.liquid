{%- comment -%}
  Vigor Sport Nutrition · imagen con texto.
  Si no eliges imagen, usa la imagen de ejemplo indicada en "Imagen de ejemplo".
{%- endcomment -%}
{%- liquid
  assign imagen = section.settings.image
  if imagen != blank
    assign src = imagen | image_url: width: 1800
  else
    assign src = section.settings.fallback | append: '.jpg' | asset_url
  endif
-%}
<div class="vigor-section" style="--vigor-pad: {{ section.settings.padding }}px;">
  <div class="vigor-section__inner">
    <div class="vigor-imagen-texto{% if section.settings.image_right %} vigor-imagen-texto--derecha{% endif %}">
      <img class="vigor-imagen-texto__imagen" src="{{ src }}" alt="{{ imagen.alt | default: section.settings.heading | escape }}" loading="lazy" width="1800" height="1100">
      <div class="vigor-imagen-texto__texto">
        <h2 class="h3">{{ section.settings.heading }}</h2>
        <div>{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a class="vigor-boton vigor-boton--primario" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vigor · Imagen y texto",
  "tag": "section",
  "class": "vigor-imagen-texto-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "select", "id": "fallback", "label": "Imagen de ejemplo (si no eliges imagen)", "default": "vigor-nosotros",
      "options": [
        { "value": "vigor-nosotros", "label": "Gama de productos" },
        { "value": "vigor-hero", "label": "Banner oscuro" },
        { "value": "vigor-cat-proteinas", "label": "Proteínas" },
        { "value": "vigor-cat-rendimiento", "label": "Rendimiento" }
      ]
    },
    { "type": "checkbox", "id": "image_right", "label": "Imagen a la derecha", "default": false },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hecho para quien entrena de verdad" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Seleccionamos fórmulas con ingredientes claros y dosis útiles. Sin rellenos ni promesas imposibles: solo lo que necesitas para entrenar y recuperarte mejor.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Conócenos" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "range", "id": "padding", "label": "Espaciado vertical", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Vigor · Imagen y texto" }]
}
{% endschema %}
