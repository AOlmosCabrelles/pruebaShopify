{%- comment -%} Vigor Sport Nutrition · guía "¿Cuál es tu objetivo?" con productos recomendados {%- endcomment -%}
<div class="vigor-section vigor-objetivos" style="--vigor-pad: {{ section.settings.padding }}px;">
  <div class="vigor-section__inner">
    {%- if section.settings.heading != blank -%}<h2 class="vigor-section__heading h3">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="vigor-section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="vigor-objetivos__grid">
      {%- for block in section.blocks -%}
        {%- capture color -%}{%- render 'vigor-coleccion-info', handle: block.settings.collection.handle, dato: 'color' -%}{%- endcapture -%}
        <article class="vigor-objetivo" style="--vigor-cat: {{ color | strip }};" {{ block.shopify_attributes }}>
          <span class="vigor-objetivo__icono">
            <svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 20 20">{%- render 'icon', icon: block.settings.icon -%}</svg>
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.productos != blank -%}
            <p class="vigor-objetivo__recomendado"><strong>Te recomendamos:</strong> {{ block.settings.productos }}</p>
          {%- endif -%}
          {%- if block.settings.collection != blank -%}
            <a class="vigor-objetivo__cta" href="{{ block.settings.collection.url }}">Ver {{ block.settings.collection.title | downcase }} <span aria-hidden="true">→</span></a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vigor · Objetivos",
  "tag": "section",
  "class": "vigor-objetivos-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Cuál es tu objetivo?" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Te orientamos sobre qué suplementos encajan con lo que buscas." },
    { "type": "range", "id": "padding", "label": "Espaciado vertical", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "objetivo",
      "name": "Objetivo",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "fire", "options": [
          { "value": "fire", "label": "Fuego" }, { "value": "lightning_bolt", "label": "Rayo" }, { "value": "stopwatch", "label": "Cronómetro" },
          { "value": "heart", "label": "Corazón" }, { "value": "leaf", "label": "Hoja" }, { "value": "star", "label": "Estrella" }, { "value": "check_box", "label": "Check" } ] },
        { "type": "text", "id": "title", "label": "Objetivo", "default": "Ganar músculo" },
        { "type": "textarea", "id": "text", "label": "Explicación" },
        { "type": "text", "id": "productos", "label": "Productos recomendados" },
        { "type": "collection", "id": "collection", "label": "Colección (color y enlace)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Vigor · Objetivos" }]
}
{% endschema %}
