{%- comment -%} Vigor Sport Nutrition · suscripción a la newsletter {%- endcomment -%}
<div class="vigor-section" style="--vigor-pad: {{ section.settings.padding }}px;">
  <div class="vigor-section__inner">
    <div class="vigor-newsletter">
      <h2 class="h3">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- form 'customer', id: 'VigorNewsletter', class: 'vigor-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="VigorNewsletterEmail">Email</label>
        <input id="VigorNewsletterEmail" type="email" name="contact[email]" placeholder="Tu email" autocomplete="email" required>
        <button type="submit">{{ section.settings.button }}</button>
        {%- if form.posted_successfully? -%}
          <p class="vigor-newsletter__ok" role="status">¡Gracias! Revisa tu email.</p>
        {%- endif -%}
      {%- endform -%}
      <p class="vigor-newsletter__legal">{{ section.settings.legal }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vigor · Newsletter",
  "tag": "section",
  "class": "vigor-newsletter-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Únete al equipo Vigor" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Consejos de entrenamiento, novedades y un 10 % de descuento en tu primer pedido." },
    { "type": "text", "id": "button", "label": "Texto del botón", "default": "Suscribirme" },
    { "type": "text", "id": "legal", "label": "Texto legal", "default": "Al suscribirte aceptas nuestra política de privacidad. Puedes darte de baja cuando quieras." },
    { "type": "range", "id": "padding", "label": "Espaciado vertical", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Vigor · Newsletter" }]
}
{% endschema %}
