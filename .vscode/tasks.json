{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Shopify: dev (arrancar la app)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Shopify: deploy",
      "type": "shell",
      "command": "npm run deploy",
      "problemMatcher": []
    },
    {
      "label": "Prisma: nueva migración",
      "type": "shell",
      "command": "npx prisma migrate dev --name ${input:nombreMigracion}",
      "problemMatcher": []
    },
    {
      "label": "Prisma: Studio (ver la base de datos)",
      "type": "shell",
      "command": "npx prisma studio",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GraphQL: generar tipos",
      "type": "shell",
      "command": "npm run graphql-codegen",
      "problemMatcher": []
    },
    {
      "label": "Comprobar todo (como la CI)",
      "type": "shell",
      "command": "npm run check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc", "$eslint-stylish"]
    }
  ],
  "inputs": [
    {
      "id": "nombreMigracion",
      "type": "promptString",
      "description": "Nombre de la migración (p. ej. add_campo_x)"
    }
  ]
}
